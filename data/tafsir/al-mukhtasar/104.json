{"schema_version":1,"source_id":"markaz_tafsir_al_mukhtasar","surah":104,"surah_name":"الهُمَزة","ayah_count":9,"ayahs":{"1":{"text":"_وبال وشدة_ عذاب _لكثير_ الاغتياب للناس، _والطعن_ فيهم.","sha256":"1ff3b80c2afff539b25f50f08b09f0cd3c24162d711a9f305443be5e5158f850"},"2":{"text":"الذي همّه جمع المال _وإحصاؤه_، لا همَّ له غير ذلك.","sha256":"d568de40f00902ec2ee5112c629dac2e2c8046d5bc914ec2bbbd3a443b6f95da"},"3":{"text":"يظن أن ماله الذي جمعه سينجيه من الموت، فيبقى خالدًا في الحياة الدنيا.","sha256":"c2b98a0e4c70a8c85014d37b06955e52231daa7bf2474c57a67f5e2ad36c4cb1"},"4":{"text":"ليس الأمر كما تصوّر هذا الجاهل، _ليطرحنّ_ في نار جهنم _التي تدق وتكسر كل ما طُرِح فيها_ لشدة بأسها.","sha256":"44f81d447abb632c7cf353c611561c0a66ad52889adfb04e52d5b428f57aabb8"},"5":{"text":"وما أعلمك - أيها الرسول - ما هذه النار التي تحطم كل ما طُرِح فيها؟!","sha256":"2c66d5d305a8516ad3d030d22b71eb3218cadaf8b0674dace90d99b5dca850f3"},"6":{"text":"إنها نار الله المستعرة.","sha256":"48a550574b7ffa7898efc72a3fcc89ace093b00edc4e305bf852d025ed3ce616"},"7":{"text":"التي _تنفذ من أجسام الناس إلى قلوبهم_.","sha256":"264ae8d5c2c6314b256ae5bcd76559ed07f62fbf3e3deab5cc15dd5f82e6c4db"},"8":{"text":"إنها على المُعَذَّبين فيها _مغلقة_.","sha256":"c5ded795a518e6e38e5587c5f9930263d1a4af8b7a593e5ab634c378e78136c3"},"9":{"text":"_بعَمَد ممتدة طويلة_ حتى لا يخرجوا منها.","sha256":"de1c2ad0d11e64b35d98024899dad897c82700531a82dd51f9a36c6864c1b39b"}}}
