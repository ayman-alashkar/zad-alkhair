{"schema_version":1,"source_id":"markaz_tafsir_al_mukhtasar","surah":103,"surah_name":"العَصر","ayah_count":3,"ayahs":{"1":{"text":"أقسم سبحانه _بوقت العصر_.","sha256":"054dcb05dc2089736950cc4e0b74437c532b91168d3b548437641486cfff4915"},"2":{"text":"إن الإنسان لفي _نقصان وهلاك_.","sha256":"5c6faf6d02a9e429b7ccb1ad460dac9f989ea8e11e497e69e25423716ac9b9e9"},"3":{"text":"إلا الذين آمنوا بالله وبرسله، وعملوا الأعمال الصالحات، وأوصى بعضهم بعضًا بالحق، وبالصبر على الحق؛ فالمتصفون بهذه الصفات ناجون في حياتهم الدنيا والآخرة.","sha256":"d75ef3adbd53b1651338aa3f950dd2a1906028cfd00dc1437392f541b6b9c199"}}}
